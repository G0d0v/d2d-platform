{
  "name": "d2d-platform",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "D2D Platform — Developer to developer",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "tsc --noEmit",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.11",
    "@fastify/swagger": "9.9.4",
    "@fastify/swagger-ui": "6.1.4",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "5.12.8",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
