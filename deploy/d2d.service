[Unit]
Description=D2D development platform
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=d2d
Group=d2d
WorkingDirectory=/opt/d2d/current
EnvironmentFile=/etc/d2d.env
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/d2d
UMask=0077
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
