HOST=127.0.0.1
PORT=19090
PUBLIC_ORIGIN=http://127.0.0.1:19090
# Local: embedded PostgreSQL. Server: set a normal PostgreSQL URL.
# DATABASE_URL=postgresql://d2d:password@127.0.0.1:5432/d2d
# DATA_DIR=.d2d
REGISTRATION_MODE=invite
# First public setup must require a random secret.
# SETUP_TOKEN=

# Private loopback Forgejo backend; leave unset to disable Git.
# FORGEJO_URL=http://127.0.0.1:3001
# FORGEJO_OWNER=d2d-service
# FORGEJO_TOKEN=
